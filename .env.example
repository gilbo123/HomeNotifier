# Copy to .env and edit:  cp .env.example .env && chmod 600 .env

# ---------- Server ----------
HN_HOST=0.0.0.0
HN_PORT=8765
# Shared secret the phone must send. Generate one with:  openssl rand -hex 24
HN_AUTH_TOKEN=change-me
# URL the speaker uses to download the audio. Leave blank to auto-detect the Pi's LAN IP.
HN_PUBLIC_BASE_URL=
HN_LOG_LEVEL=INFO

# ---------- Arrival behaviour ----------
HN_OWNER_NAME=Gilbert
# Ignore repeat arrivals within this many minutes
HN_COOLDOWN_MINUTES=30
# Wait before speaking (Wi-Fi often connects while you're still in the driveway)
HN_ARRIVAL_DELAY_SECONDS=20
# No announcements in this window (blank = disabled)
HN_QUIET_HOURS=22:00-07:00
# Blank = use the Pi's system timezone
HN_TIMEZONE=Australia/Sydney

# ---------- Google Calendar ----------
# Your calendar ID - "primary" works for OAuth; use your Gmail address for a service account.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_EVENT_COUNT=3
# Option A (recommended for a headless Pi): service-account key
GOOGLE_SERVICE_ACCOUNT_FILE=
# Option B: OAuth desktop client
GOOGLE_OAUTH_CLIENT_FILE=secrets/client_secret.json
GOOGLE_TOKEN_FILE=secrets/token.json

# ---------- Weather (Open-Meteo, no key needed) ----------
WEATHER_LATITUDE=-33.8688
WEATHER_LONGITUDE=151.2093
WEATHER_LOCATION_NAME=

# ---------- Ollama ----------
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=90
# How long the model stays in RAM after use. "0" = unload immediately (saves ~1-2 GB).
OLLAMA_KEEP_ALIVE=5m
# Set to false when using a qwen3 model to skip its slow "thinking" phase
OLLAMA_THINK=

# ---------- Speaker / TTS ----------
# Exact name as shown in the Google Home app (case-sensitive)
SPEAKER_NAME=Kitchen speaker
# Optional: speaker IP (more reliable than mDNS discovery; give it a DHCP reservation)
SPEAKER_IP=
# Optional: 0.0-1.0. Blank = leave volume unchanged
SPEAKER_VOLUME=
TTS_LANG=en
# Accent: com.au (Australian), co.uk, com (US), ca, co.in, ie, co.za
TTS_TLD=com.au

# ---------- Optional: Wi-Fi presence detection (no phone app required) ----------
# Phone's fixed LAN IP (set a DHCP reservation). Blank = disabled.
PRESENCE_PHONE_IP=
PRESENCE_INTERVAL_SECONDS=30
PRESENCE_AWAY_MINUTES=20
