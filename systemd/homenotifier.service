[Unit]
Description=HomeNotifier - spoken arrival briefings
Documentation=https://github.com/gilbo123/HomeNotifier
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=simple
# Change User/Group and paths if your username or install location differ.
User=server
Group=server
WorkingDirectory=/home/server/git/HomeNotifier
EnvironmentFile=/home/server/git/HomeNotifier/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/server/.virtualenvs/notify/bin/python -m homenotifier
Restart=on-failure
RestartSec=10

# Be a good neighbour to the other services on the Pi
MemoryMax=768M
Nice=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/server/git/HomeNotifier/audio_cache /home/server/git/HomeNotifier/secrets /home/server/git/HomeNotifier/voices

[Install]
WantedBy=multi-user.target
